set_location_assignment PIN_M22 -to e_txen
set_location_assignment PIN_V21 -to e_txer

set_location_assignment PIN_T2 -to fpga_gclk
set_location_assignment PIN_J4 -to reset_n


set_location_assignment PIN_C22 -to p_e_reset  # 3
set_location_assignment PIN_B22 -to p_e_txen   # 5
set_location_assignment PIN_H20 -to p_e_gtxc   # 7

set_location_assignment PIN_A9  -to p_e_txd[7] # 35
set_location_assignment PIN_A10 -to p_e_txd[6] # 33
set_location_assignment PIN_A13 -to p_e_txd[5] # 31
