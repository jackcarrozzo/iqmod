# USB SERIAL: TX RX: AA22 AA21

# LEDS D5 D6: Y17 W17
# BUTTONS SW1 SW4 SW3 (on sch): P4 P4 nCONFIG

# PMOD J11: (outside one near jtag)
#   right to left:
#     top row, pins 1-6: R2 P2 N2 M2 gnd 3v3
#     bottom, pins 7-12: R1 P1 N1 M1 gnd 3v3

# PMOD J10: (middle one)
#   right to left: 
#     top row, pins 1-6: J1 H1 F1 E1 gnd 3v3
#     bottom, pins 7-12: J2 H2 F2 D2 gnd 3v3

# JP1: (slightly wider one)
#   left to right!
#     top row, pins 2-18 even: gnd A7^ C8 A6 A5 C4 A4 A3 B2
#     bottom, pins 1-17 odd  : 3v3 B7?^ C7 B6 B5 C3 B4 B3 B1
# ^ means 4.7k pullup to 3v3; ? means that B7 is listed as
#   expected on the schematic, next to the others, but is
#   also present as a pin alone by itself floating near 
#   the pmod defs.

# J12: (long one)
#   left to right:
#     bottom/edge row, pins 1-39: 
#       gnd C20 C19 A20 A19 A18 A17 A16 D15 A15 C13 A14 A13 A11 A10 D10 A9 A8 gnd 3v3
#     top/inside row,  pins 2-40:
#       vin_5v D20 D19 B20 B19 B18 B17 B16 E15 B15 D13 B14 B13 B11 B10 E10 B9 B8 gnd 3v3

# DAC5672 board pinout:
#  dac  pin  io
#  DB0   5   C19
#  DB1   6   D19
#  DB2   7   A20
#  DB3   8   B20
#  DB4   9   A19
#  DB5  10   B19
#  DB6  11   A18
#  DB7  12   B18
#  DB8  13   A17
#  DB9  14   B17
# DB10  15   A16
# DB11  16   B16
# DB12  17   D15
# DB13  18   E15
# WRTB  19   A15
# CLKB  20   B15
# CLKA  21   C13
# WRTA  22   D13
#  DA0  23   A14
#  DA1  24   B14
#  DA2  25   A13
#  DA3  26   B13
#  DA4  27   A11 -- C20
#  DA5  28   B11 -- D20
#  DA6  29   A10
#  DA7  30   B10
#  DA8  31   D10
#  DA9  32   E10
# DA10  33   A9
# DA11  34   B9
# DA12  35   A8
# DA13  36   B8
# AGND  37   GND
#  GND  38   GND
#   VA  39   3V3
#  VCC  40   3V3

# switches: from closest to jtag to farthest:
#   SW3 SW4 SW1 connected to nCONFIG P3 P4 (pulled up, switch grounds)

# LEDs: closest to switches to farthest:
#   D4 D5 D6 connected to gnd Y17 W17 (active low)
set_location_assignment PIN_Y17 -to led_0 # D5
set_location_assignment PIN_W17 -to led_1 # D6

# onboard 3-dig 7-seg:
#   DIG_1, DIG_2, and DIG_3 get 3v3 thru pnp enabled by AB18, U19, R18
#   SEG_s A B C D E F G DP are AA19 R19 U20 AB19 AA18 W20 R20 W19
set_location_assignment PIN_AB18 -to dig_ena[0] # DIG_1
set_location_assignment PIN_U19  -to dig_ena[1] # DIG_2
set_location_assignment PIN_R18  -to dig_ena[2] # DIG_3
set_location_assignment PIN_AA19 -to dig_seg[0] # A
set_location_assignment PIN_R19  -to dig_seg[1] # B
set_location_assignment PIN_U20  -to dig_seg[2] # C
set_location_assignment PIN_AB19 -to dig_seg[3] # D
set_location_assignment PIN_AA18 -to dig_seg[4] # E
set_location_assignment PIN_W20  -to dig_seg[5] # F
set_location_assignment PIN_R20  -to dig_seg[6] # G
set_location_assignment PIN_W19  -to dig_seg[7] # DP

# onboard usb serial CP2102N at J4:
#   TXD RXD are AA22 AA21

# comment is the 7seg segment designation, not another fpga pin
set_location_assignment PIN_R2 -to pmod2char[0] # AA
set_location_assignment PIN_P2 -to pmod2char[1] # AB
set_location_assignment PIN_N2 -to pmod2char[2] # AC
set_location_assignment PIN_M2 -to pmod2char[3] # AD

set_location_assignment PIN_J1 -to pmod2char[4] # AE
